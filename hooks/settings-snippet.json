{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$HOME/.desk-waifu/state-writer.sh" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$HOME/.desk-waifu/state-writer.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "$HOME/.desk-waifu/state-writer.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "$HOME/.desk-waifu/state-writer.sh" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "$HOME/.desk-waifu/state-writer.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.desk-waifu/state-writer.sh" } ] }
    ]
  }
}
